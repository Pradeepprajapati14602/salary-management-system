{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @salary-mgmt/shared build && pnpm prisma:generate && tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prisma:generate": "pnpm exec prisma generate",
    "migrate:up": "pnpm exec prisma migrate deploy",
    "migrate:dev": "pnpm exec prisma migrate dev",
    "migrate:reset": "pnpm exec prisma migrate reset --force",
    "prisma:seed": "pnpm exec prisma db seed",
    "seed": "tsx src/db/seed/entry.ts",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit --exclude tests/unit/employee.repository.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:perf": "vitest run tests/performance",
    "lint": "eslint src tests --ext .ts"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "@salary-mgmt/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^10.16.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.4.7",
    "prisma": "^6.8.2",
    "supertest": "^7.0.0",
    "testcontainers": "^10.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
